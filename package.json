{
  "name": "taskflow-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "TaskFlow desktop application",
  "main": "electron/main.cjs",
  "scripts": {
    "build:web": "npm --prefix frontend run build",
    "desktop": "npm run build:web && electron .",
    "dist:windows": "npm run build:web && electron-builder --win nsis"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.taskflow.desktop",
    "productName": "TaskFlow",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "backend/**/*",
      "frontend/dist/**/*",
      "package.json",
      "!backend/taskflow.db*",
      "!backend/dev.log",
      "!frontend/dev.log"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
